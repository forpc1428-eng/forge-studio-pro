{
  "name": "forge-studio-pro-desktop",
  "productName": "Forge Studio Pro",
  "version": "2.0.0",
  "description": "Forge Studio Pro: visual app builder (desktop edition)",
  "author": "Forge Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.forge.studiopro",
    "productName": "Forge Studio Pro",
    "copyright": "Forge Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge Studio Pro",
      "artifactName": "Forge-Studio-Pro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Forge-Studio-Pro-Portable-${version}.${ext}"
    }
  }
}
